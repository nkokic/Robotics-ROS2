<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="hole">
    <static>true</static>

    <link name="hole_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="hole_visual">
        <geometry>
          <mesh>
            <uri>hole.stl</uri>
          </mesh>
        </geometry>

        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <collision name="hole_collision">
        <geometry>
          <mesh>
            <uri>hole.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>