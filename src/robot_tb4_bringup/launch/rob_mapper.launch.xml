<launch>
  <include file="$(find-pkg-share turtlebot4_gz_bringup)/launch/turtlebot4_gz.launch.py">
    <arg name="model" value="lite"/>
    <arg name="world" value="depot"/>
  </include>

  <include file="$(find-pkg-share turtlebot4_navigation)/launch/slam.launch.py">
    <arg name="use_sim_time" value="true"/>
  </include>

  <include file="$(find-pkg-share turtlebot4_viz)/launch/view_navigation.launch.py"/>

  <!-- Interactive WASD teleoperation in a dedicated terminal window. -->
  <node pkg="robot_tb4_bringup" exec="wasd_teleop.py" name="keyboard_teleop"
        output="screen" launch-prefix="gnome-terminal --"/>

  <!-- Live RGB feed from the simulated OAK-D camera. -->
  <node pkg="rqt_image_view" exec="rqt_image_view" name="camera_image_view"
        output="screen" args="/oakd/rgb/preview/image_raw"/>
</launch>